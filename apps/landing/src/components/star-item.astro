---
import { getRandomNumber } from "../utils";
import { getRelativeLocaleUrl } from "astro:i18n";
interface Props {
    itemId: number;
    isActive?: boolean;
    isHidden?: boolean;
    top?: string;
    left?: string;
    radius?: number;
    label?: string;
    color?: string;
    href?: string;
    coordinates: {
        x: number;
        y: number;
    };
    animation?: "wander" | "burst";
}

const {
    animation = "wander",
    color = "black",
    href = "/",
    isActive = false,
    isHidden = true,
    itemId,
    label = "",
    left = "0",
    radius = 10,
    top = "0",
} = Astro.props;

const innerSize = `${radius}px`;
const outerSize = `${radius + 5}px`;
const pulsarId = `outer-pulsar-${itemId}`;
const containerId = `star-item-container-${itemId}`;
const delay = getRandomNumber(0, 3000);
const range = label ? 120 : 250;
function getWaypoint() {
    return {
        x: Math.round(getRandomNumber(-range, range)),
        y: Math.round(getRandomNumber(-range, range)),
    };
}
const waypoints = Array.from({ length: Math.round(getRandomNumber(3, 4)) }, getWaypoint);
function getRandomFloat(min: number, max: number) {
    return Math.random() * (max - min) + min;
}
function getBurstDestination() {
    const angle = getRandomFloat(0, Math.PI * 2);
    // Far enough to always leave the viewport, so stars never visibly stop.
    const distance = 150;
    return {
        x: Number((Math.cos(angle) * distance).toFixed(2)),
        y: Number((Math.sin(angle) * distance).toFixed(2)),
    };
}
const burst = getBurstDestination();
const duration =
    animation === "burst"
        ? // Constant slow speed: 0.3–0.6 vmax per second.
          Math.round((150 / getRandomFloat(0.5, 0.9)) * 1000)
        : Math.round(getRandomNumber(30000, 45000));
const currentLocale = Astro.currentLocale ?? "en";
---

<star-item
    data-pulsar-id={pulsarId}
    data-container-id={containerId}
    data-delay={delay}
    data-waypoints={JSON.stringify(waypoints)}
    data-duration={duration}
    data-animation={animation}
    data-burst={JSON.stringify(burst)}
    data-current-locale={currentLocale}
>
    <div
        class:list={[
            "absolute transition-[visibility,opacity] duration-500 ease-linear translate-6",
            isHidden ? "invisible opacity-0" : "visible opacity-100",
        ]}
        id={containerId}
        style={{
            top,
            left,
            color,
        }}
    >
        <div class="relative">
            <div
                class="absolute rounded-full"
                style={{
                    width: innerSize,
                    height: innerSize,
                    backgroundColor: color,
                }}
            ></div>
            <div
                id={pulsarId}
                class="absolute rounded-full opacity-30"
                style={{
                    width: outerSize,
                    height: outerSize,
                    backgroundColor: color,
                }}
            ></div>
            {label && (
                <div
                    class:list={[
                        "absolute top-[30px] transition-transform duration-200 ease-in text-sm md:text-base",
                        isActive && "text-white scale-150",
                    ]}
                >
                    <div class="relative">
                        <a href={getRelativeLocaleUrl(currentLocale, href)}>
                            <span class="absolute uppercase font-mono font-black tracking-[3px] text-pink-500">
                                {label}
                            </span>
                        </a>
                    </div>
                </div>
            )}
        </div>
    </div>
</star-item>

<script>
    class StarItem extends HTMLElement {
        connectedCallback() {
            const pulsarId = this.dataset.pulsarId;
            const delay = Number(this.dataset.delay);
            const containerId = this.dataset.containerId;
            const duration = Number(this.dataset.duration);
            const waypoints: { x: number; y: number }[] = JSON.parse(this.dataset.waypoints ?? "[]");
            const animation = this.dataset.animation ?? "wander";
            const burst: { x: number; y: number } = JSON.parse(this.dataset.burst ?? '{"x":0,"y":0}');

            if (!containerId || !pulsarId) return;

            document.addEventListener("DOMContentLoaded", () => {
                const PADDING = 20;
                const tooltipLabel = this.querySelector(`#${pulsarId} + div span`) as HTMLElement;

                if (tooltipLabel) {
                    const rect = tooltipLabel.getBoundingClientRect();
                    if (rect.right >= window.innerWidth) {
                        tooltipLabel.style.left = `-${rect.right - window.innerWidth + PADDING}px`;
                    }
                }

                // Animation using Web Animations API instead of motion library
                const container = this.querySelector<HTMLElement>(`#${containerId}`);

                if (container && animation === "burst") {
                    container.animate(
                        [
                            { transform: "translate(0, 0)" },
                            { transform: `translate(${burst.x}vmax, ${burst.y}vmax)` },
                        ],
                        {
                            delay,
                            duration,
                            easing: "linear",
                            fill: "forwards",
                        },
                    );
                } else if (container) {
                    const points = [{ x: 0, y: 0 }, ...waypoints, { x: 0, y: 0 }];
                    const keyframes = points.map(point => ({
                        transform: `translate(${point.x}px, ${point.y}px)`,
                        easing: "ease-in-out",
                    }));
                    container.animate(keyframes, {
                        delay,
                        duration,
                        iterations: Infinity,
                    });
                }

                const pulsar = this.querySelector<HTMLElement>(`#${pulsarId}`);
                setTimeout(() => {
                    if (pulsar) {
                        pulsar.animate(
                            [
                                { transform: "scale(1)", opacity: 0.3 },
                                { transform: "scale(1.9)", opacity: 0 },
                            ],
                            {
                                delay,
                                duration: 2000,
                                easing: "ease-out",
                                iterations: Infinity,
                            },
                        );
                    }
                }, delay);
            });
        }
    }

    customElements.define("star-item", StarItem);
</script>
