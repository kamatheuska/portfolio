---
import { Icon } from "astro-icon/components";

interface Props {
    /** Icon color/size classes; defaults to the dark-theme pink */
    class?: string;
    /** Iconify icon name */
    icon?: string;
}

const { class: className = "text-pink-400", icon = "uil:bars" } = Astro.props;
---

<div class="text-3xl cursor-pointer">
    <span
        @click="updateBackgroundStyles($data)"
        class:list={[
            // Animated circle in the icon's color on hover. Padding gives the
            // circle room; the negative margin keeps the layout unchanged.
            "relative inline-flex p-2 -m-2 rounded-full transition-colors duration-300",
            "before:absolute before:inset-0 before:rounded-full before:bg-current",
            "before:opacity-0 before:scale-50 before:transition before:duration-300 before:ease-out",
            "hover:before:opacity-15 hover:before:scale-100",
            className,
        ]}
    >
        <Icon name={icon} class="relative" />
    </span>
</div>
