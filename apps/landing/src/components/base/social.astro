---
import { Icon } from "astro-icon/components";

interface Social {
    href: string;
    aria_label: string;
    icon: string;
}

const response = await fetch("http://localhost:3001/api/settings/home-links");
const data = (await response.json()) as { records: Social[] };
const social: Social[] = response.ok ? data.records : [];
---

<ul class="mt-0 text-2xl flex mb-5">
    {
        social.map((item, index) => (
            <li class={index !== social.length - 1 ? "mr-4" : ""}>
                <a
                    href={item.href}
                    target="_blank"
                    aria-label={item.aria_label}
                    class="text-pink-500 hover:text-green-400 transition-colors"
                >
                    <Icon name={item.icon} class="w-8 h-8" />
                </a>
            </li>
        ))
    }
</ul>
