---
import { Icon } from "astro-icon/components";
import { adminFetchJson } from "../../lib/admin-client";

interface Social {
    href: string;
    aria_label: string;
    icon: string;
}

let social: Social[] = [];
try {
    const data = await adminFetchJson<{ records: Social[] }>(
        "/api/settings/home-links",
    );
    social = data.records ?? [];
} catch (error) {
    console.error("Failed to load social links", error);
}
---

<ul class="mt-0 text-2xl flex mb-5">
    {
        social.map((item, index) => (
            <li class={index !== social.length - 1 ? "mr-4" : ""}>
                <a
                    href={item.href}
                    target="_blank"
                    aria-label={item.aria_label}
                    class="text-pink-500 hover:text-green-400 transition-colors"
                >
                    <Icon name={item.icon} class="w-8 h-8" />
                </a>
            </li>
        ))
    }
</ul>
