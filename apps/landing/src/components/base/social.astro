---
import { Icon } from "astro-icon/components";
import { adminFetchJson } from "../../lib/admin-client";

interface Social {
    href: string;
    ariaLabel: string;
    icon: string;
}

interface HomeLink {
    id: number;
    icon: string;
    ariaLabel: string;
    href: string;
    updatedAt: string;
    createdAt: string;
}

let social: Social[] = [];
type HomeLinkResponse = {
    docs: HomeLink[];
};
try {
    const data = await adminFetchJson<HomeLinkResponse>("/api/home-links");
    social = data.docs.map(link => ({
        href: link.href,
        ariaLabel: link.ariaLabel,
        icon: link.icon,
    }));
} catch (error) {
    console.error("Failed to load social links", error);
}
---

<ul class="mt-0 text-2xl flex mb-5">
    {social.map((item, index) => (
        <li class={index !== social.length - 1 ? "mr-4" : ""}>
            <a
                href={item.href}
                target="_blank"
                aria-label={item.ariaLabel}
                class="text-pink-500 hover:text-green-400 transition-colors"
            >
                <Icon name={item.icon} class="w-8 h-8" />
            </a>
        </li>
    ))}
</ul>
