---
import "../styles/base.css";
import Button from "../components/button.astro";
import Social from "../components/base/social.astro";
import Menu from "../components/menu.astro";
import RootLayout from "../layouts/root-layout.astro";
import Content from "../components/content.astro";
import { adminFetchJson } from "../lib/admin-client";
// import { getRelativeLocaleUrl } from "astro:i18n";

export function getStaticPaths() {
    return [{ params: { lang: "en" } }, { params: { lang: "es" } }];
}
// const currentLocale = Astro.currentLocale ?? "en";
// const aboutURL = getRelativeLocaleUrl(currentLocale, "about");

// For client-side interactivity
interface Setting {
    id: number;
    homeHeading?: string | null;
    updatedAt?: string | null;
    createdAt?: string | null;
}
let homeHeading: string | null = null;
try {
    const data = await adminFetchJson<Setting>("/api/globals/settings");
    homeHeading = data.homeHeading ?? null;
} catch (error) {
    console.error("Failed to load social links", error);
}
---

<RootLayout
    title="Nicolas Ramirez - Software Developer"
    description="Full-stack software developer specializing in creating great products for the web. Building great products for the web with React, Node.js, TypeScript, and more."
>
    <main class="text-right" x-data="stars">
        <div>
            <Menu />
            <Content showBackdrop>
                <h3 class="text-light-green text-lg font-mono m-0">Hi! My name is</h3>
                <h1 class="text-pink-400 font-bold font-serif text-[12vw] md:text-[6vw] m-0">
                    Nicolas Ramirez
                </h1>
                <p class="text-light-blue max-w-[350px] md:text-lg mb-5">{homeHeading}</p>
                <Social />
                <div class="transition-opacity duration-300">
                    <Button @click="updateBackgroundStyles($data)"> Start </Button>
                </div>
            </Content>
        </div>
        <script src="../scripts/star-menu-controller"></script>
    </main>
</RootLayout>
